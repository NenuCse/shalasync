# ============================================================
# ShalaSync — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to GitHub — it is in .gitignore.
# ============================================================

# ── Supabase (REQUIRED) ────────────────────────────────────
# Get these from: https://supabase.com/dashboard
#   → Your Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── NOTES ──────────────────────────────────────────────────
# Both variables above start with NEXT_PUBLIC_ which means
# they are SAFE to expose to the browser. The anon key is
# protected by Supabase Row Level Security (RLS).
#
# NEVER add SUPABASE_SERVICE_ROLE_KEY to this file or to
# Vercel environment variables for the frontend.
# The service role key bypasses all RLS and is dangerous.
# ============================================================
